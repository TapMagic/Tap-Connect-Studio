{
  "name": "tap-connect-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test lib/control/**/__tests__/**/*.test.ts lib/fusion/**/__tests__/**/*.test.ts lib/fusion/__tests__/**/*.test.ts lib/fusion/**/*.test.ts lib/media/**/__tests__/**/*.test.ts lib/services/**/__tests__/**/*.test.ts lib/utils/**/__tests__/**/*.test.ts components/**/__tests__/**/*.test.ts",
    "test:control": "node --import tsx --test lib/control/**/__tests__/**/*.test.ts",
    "test:control:e2e": "playwright test e2e/control-room.spec.ts",
    "test:fusion": "node --import tsx --test lib/fusion/**/__tests__/**/*.test.ts lib/fusion/__tests__/**/*.test.ts",
    "test:e2e:proofs": "playwright test e2e/*.spec.ts",
    "test:e2e:proofs:headed": "PROOF_HEADED=1 playwright test e2e/*.spec.ts --headed",
    "smoke:fusion": "npx tsx scripts/fusion-smoke-routes.ts",
    "smoke:fusion:curl": "bash scripts/fusion-smoke-curl.sh",
    "postinstall": "prisma generate || true",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/fusion-migrate.ts dev",
    "db:migrate:deploy": "tsx scripts/fusion-migrate.ts deploy",
    "db:migrate:status": "tsx scripts/fusion-migrate.ts status",
    "db:push": "echo 'REFUSED: use npm run db:migrate against isolated tapconnect_fusion_dev only. See docs/fusion/LOCAL_DEV_DATABASE.md' && exit 1",
    "db:studio": "prisma studio",
    "fusion:dev-db": "docker compose -f docker-compose.fusion-dev.yml up -d",
    "fusion:db-ready": "node --import tsx scripts/fusion-db-readiness.ts",
    "fusion:seed": "node --import tsx scripts/fusion-seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@base-ui/react": "^1.6.0",
    "@clerk/nextjs": "^7.5.17",
    "@clerk/ui": "^1.25.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.23.0",
    "nanoid": "^5.1.16",
    "next": "16.2.10",
    "openai": "^6.46.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "resend": "^6.17.2",
    "shadcn": "^4.13.0",
    "simple-icons": "^16.26.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "clerk": "^2.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsqr": "^1.4.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
