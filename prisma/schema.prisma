  resource CreativeResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, resourceId])
  @@index([businessId, userId, createdAt])
}

model CreativeResourceRecent {
  id         String   @id @default(cuid())
