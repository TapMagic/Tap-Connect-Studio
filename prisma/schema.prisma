  @@unique([businessId, channel, address])
  @@index([businessId, channel])
}

// ─── TapLoop loyalty (append-only ledger) ─────────────────────────────────────

enum LoyaltyEnrollmentStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum LoyaltyLedgerType {
  AWARD
  REDEEM
  REVERSE
  ADJUST
  EXPIRE
}

model LoyaltyProgram {
  id         String   @id @default(cuid())
  businessId String
  name       String
  active     Boolean  @default(true)
  /** [{ id, label, points, event }] */
  earnRules  Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tiers       LoyaltyTier[]
  rewards     LoyaltyReward[]
  enrollments LoyaltyEnrollment[]
  ledger      LoyaltyLedgerEntry[]

  @@index([businessId, active])
}

model LoyaltyTier {
  id              String @id @default(cuid())
  programId       String
  name            String
  rank            Int    @default(0)
  thresholdPoints Int    @default(0)
  /** string[] */
  perks           Json   @default("[]")

  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, rank])
}

model LoyaltyReward {
  id         String  @id @default(cuid())
  programId  String
  name       String
  pointsCost Int
  active     Boolean @default(true)
  metadata   Json    @default("{}")

  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, active])
}

model LoyaltyEnrollment {
  id             String                  @id @default(cuid())
  programId      String
  businessId     String
  contactId      String
  relationshipId String?
  status         LoyaltyEnrollmentStatus @default(ACTIVE)
  consentedAt    DateTime
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  program      LoyaltyProgram         @relation(fields: [programId], references: [id], onDelete: Cascade)
  business     Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact      Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  relationship CustomerRelationship?  @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  ledger       LoyaltyLedgerEntry[]

  @@unique([programId, contactId])
  @@index([businessId, status])
  @@index([contactId])
}

model LoyaltyLedgerEntry {
  id              String            @id @default(cuid())
  programId       String
  businessId      String
  enrollmentId    String
  contactId       String
  relationshipId  String?
  type            LoyaltyLedgerType
  /** Always store positive magnitude; sign implied by type (see computeBalance) */
  points          Int
  reason          String
  evidenceId      String?
  campaignId      String?
  rewardId        String?
  /** Unique per business — prevents duplicate award/redeem/reverse */
  idempotencyKey  String
  reversesEntryId String?
  createdBy       String            @default("staff")
  createdAt       DateTime          @default(now())

  program      LoyaltyProgram        @relation(fields: [programId], references: [id], onDelete: Cascade)
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enrollment   LoyaltyEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  contact      Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  relationship CustomerRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([enrollmentId, createdAt])
  @@index([programId, createdAt])
  @@index([contactId, createdAt])
  @@index([reversesEntryId])
}

// ─── TapCanvas (persisted visual operating environment) ───────────────────────

enum TapCanvasMode {
  sketch
  build
  operate
  analyze
}

enum CanvasProposalStatus {
  pending
  accepted
  rejected
  previewed
}

enum CanvasApprovalStatus {
  pending
  approved
  rejected
  invalidated
}

model TapCanvasDocument {
  id          String        @id @default(cuid())
  businessId  String
  name        String
  mode        TapCanvasMode @default(sketch)
  version     Int           @default(1)
  /** Authoritative graph: { nodes, edges } */
  graph       Json          @default("{\"nodes\":[],\"edges\":[]}")
  /** comments, overlays, issues cache, permissions, collaboration */
  metadata    Json          @default("{}")
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business     Business                          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  versions     CanvasVersionRecord[]
  items        CanvasItem[]
  connectors   CanvasConnector[]
  frames       CanvasFrame[]
  comments     CanvasComment[]
  bindings     CanvasObjectBinding[]
  proposals    CanvasProposal[]
  approvals    CanvasApproval[]
  overlays     CanvasExecutionOverlay[]
  issues       CanvasIssue[]
  ewiProjections CanvasExternalWorkItemProjection[]
  auditLogs    CanvasAuditLog[]

  @@index([businessId, updatedAt])
  @@index([businessId, archivedAt])
}

model CanvasVersionRecord {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  label      String
  snapshot   Json
  createdBy  String?
  createdAt  DateTime @default(now())

  document TapCanvasDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model CanvasItem {
  id         String   @id @default(cuid())
  documentId String
  nodeId     String
  kind       String
  label      String
  x          Float    @default(0)
  y          Float    @default(0)
  width      Float?
  height     Float?
  sketch     Boolean  @default(false)
  data       Json     @default("{}")
  liveStatus String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document TapCanvasDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, nodeId])
  @@index([documentId, kind])
}

model CanvasConnector {
  id         String   @id @default(cuid())
  documentId String
  edgeId     String
  source     String
  target     String
  label      String?
  kind       String   @default("flow")
  sketch     Boolean  @default(false)
  data       Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document TapCanvasDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, edgeId])
  @@index([documentId])
}

model CanvasFrame {
  id         String   @id @default(cuid())
  documentId String
  nodeId     String
  label      String
  x          Float    @default(0)
  y          Float    @default(0)
  width      Float    @default(320)
  height     Float    @default(200)
  data       Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document TapCanvasDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, nodeId])
}

model CanvasComment {
  id         String   @id @default(cuid())
  documentId String
  nodeId     String?
  body       String
  authorId   String?
  mentionIds Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document TapCanvasDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}

model CanvasObjectBinding {
  id         String   @id @default(cuid())
  documentId String
  nodeId     String
  objectType String
  objectId   String
  provider   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document TapCanvasDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, nodeId])
  @@index([objectType, objectId])
  @@index([documentId])
}

model CanvasProposal {
  id            String               @id @default(cuid())
  documentId    String
  title         String
  description   String
  severity      String               @default("info")
  status        CanvasProposalStatus @default(pending)
  proposedPatch Json                 @default("{}")
  evidence      Json                 @default("[]")
  confidence    Float                @default(0.5)
  resolvedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  document TapCanvasDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, status])
}

model CanvasApproval {
  id           String               @id @default(cuid())
  documentId   String
  subjectType  String
  subjectId    String
  status       CanvasApprovalStatus @default(pending)
  workItemId   String?
  decidedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  document TapCanvasDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, status])
}

model CanvasExecutionOverlay {
  id         String   @id @default(cuid())
  documentId String
  snapshot   Json     @default("{}")
  capturedAt DateTime @default(now())

  document TapCanvasDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

