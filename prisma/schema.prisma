enum FusionThreadChannel {
  EMAIL
  MESSENGER
  INSTAGRAM_DM
  WHATSAPP
  TELEGRAM
  SMS
  MANYCHAT
}

enum FusionThreadStatus {
  OPEN
  PENDING
  CLOSED
}

enum FusionMessageDirection {
