// ─── Brand vocabulary / AI Keywords (canonical shared system) ────────────────

enum VocabularyTermKind {
  KEYWORD
  HASHTAG
  BRANDED_HASHTAG
  LOCAL_TERM
  AUDIENCE_TERM
  INTENT_TERM
  SEO_PHRASE
  TITLE_PHRASE
  CAPTION_PHRASE
  COMMENT_TRIGGER
  DM_TRIGGER
  SYNONYM
  MISSPELLING
  INTERNAL_TAG
  REQUIRED_TERM
  EXCLUDED_TERM
  COMPETITOR_EXCLUSION
}

enum VocabularyApprovalStatus {
  SUGGESTED
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum VocabularyScope {
  WORKSPACE
  BUSINESS
  LOCATION
  CAMPAIGN
  BRAND_PACK
  CHANNEL
}

enum VocabularySourceType {
  BRAND_KIT
  MANUAL
  GROUNDED_SUGGEST
  AUTOPILOT
  IMPORT
  PERFORMANCE_STUB
  LEGACY_JSON
}

model BrandVocabularyTerm {
  id              String                   @id @default(cuid())
  businessId      String
  brandKitId      String?
  kind            VocabularyTermKind
  value           String
  normalizedValue String
  locale          String                   @default("en")
  scope           VocabularyScope          @default(BUSINESS)
  approvalStatus  VocabularyApprovalStatus @default(SUGGESTED)
  sourceType      VocabularySourceType     @default(MANUAL)
  sourceReference String?
  rationale       String?
  confidence      Float?
  locked          Boolean                  @default(false)
  active          Boolean                  @default(true)
  channels        Json                     @default("[]")
  locationId      String?
  campaignId      String?
  capitalization  String?
  reviewAt        DateTime?
  expiresAt       DateTime?
  createdBy       String?
  approvedBy      String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  archivedAt      DateTime?

  business        Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  brandKit        BrandKit?                   @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  packMembers     BrandVocabularyPackMember[]
  triggerBindings VocabularyTriggerBinding[]

  @@unique([businessId, kind, normalizedValue, scope])
  @@index([businessId, approvalStatus, active])
  @@index([businessId, kind])
  @@index([brandKitId])
  @@index([campaignId])
}

model BrandVocabularyPack {
  id          String    @id @default(cuid())
  businessId  String
  brandKitId  String?
  slug        String
  name        String
  description String?
  locale      String    @default("en")
  channels    Json      @default("[]")
  version     Int       @default(1)
  approved    Boolean   @default(false)
  archivedAt  DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  brandKit BrandKit?                   @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  members  BrandVocabularyPackMember[]

  @@unique([businessId, slug])
  @@index([businessId, archivedAt])
}

model BrandVocabularyPackMember {
  id        String   @id @default(cuid())
  packId    String
  termId    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  pack BrandVocabularyPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  term BrandVocabularyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([packId, termId])
  @@index([termId])
}

model VocabularySuggestionRun {
  id                 String   @id @default(cuid())
  businessId         String
  channel            String?
  campaignId         String?
  surface            String?
  requestContext     Json     @default("{}")
  generated          Json     @default("[]")
  selected           Json     @default("[]")
  rejected           Json     @default("[]")
  appliedDestination String?
  modelProvider      String   @default("local_grounded")
  recipeVersion      String   @default("keywords.v1")
  costCents          Int      @default(0)
  evidenceClass      String   @default("modeled")
  actorId            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, channel])
  @@index([campaignId])
}

model VocabularyAnalyticsEvent {
  id         String   @id @default(cuid())
  businessId String
  event      String
  count      Int      @default(1)
  channel    String?
  campaignId String?
  families   Json     @default("[]")
  detail     Json     @default("{}")
  /**
   * Always counts_only_no_causal_claim — never interpret as lift
   */
  disclaimer String   @default("counts_only_no_causal_claim")
  actorId    String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, event, createdAt])
  @@index([businessId, channel])
}

/**
 * Active conversational trigger bindings — collisions detected within scope
 */
model VocabularyTriggerBinding {
  id              String    @id @default(cuid())
  businessId      String
  termId          String?
  flowId          String
  flowLabel       String?
  matchMode       String    @default("contains")
  canonicalValue  String
  normalizedValue String
  channel         String    @default("tapcanvas")
  locationId      String?
  campaignId      String?
  active          Boolean   @default(true)
  activeFrom      DateTime?
  activeTo        DateTime?
  fallbackNote    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  term     BrandVocabularyTerm? @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@unique([businessId, normalizedValue, channel, flowId])
  @@index([businessId, normalizedValue, channel, active])
  @@index([flowId])
}

// ─── Email & Replies / Reply Routing (provider-neutral) ───────────────────────

enum ReplyHandlingMode {
  TAP_ROUTE_EXTERNAL
  TAP_INBOX
  DIRECT_EXTERNAL
  CONNECTED_DESTINATION
}

enum ReplyDestinationType {
  EMAIL_ADDRESS
  TAP_INBOX
  INTEGRATION
  WEBHOOK
  DIRECT_REPLY_TO
}

enum ReplyVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
  REVOKED
}

enum ReplyDestinationRole {
  PRIMARY
  FALLBACK
}

enum ReplyRoutingState {
  RECEIVED
  CONTEXT_MATCHED
  CLASSIFIED
  ROUTE_PENDING
  ROUTED
  ROUTE_FAILED
  RETAINED_IN_TAP
  PAUSED
  SKIPPED_DIRECT
}

/**
 * Verified reply destination — no provider secrets in this row
 */
model ReplyDestination {
  id                         String                  @id @default(cuid())
  businessId                 String
  locationId                 String?
  name                       String
  destinationType            ReplyDestinationType
  /**
   * Opaque reference (integration id, webhook id) — never a secret
   */
  destinationReference       String?
  /**
   * Normalized email or endpoint reference (not a credential)
   */
  normalizedAddress          String?
  verificationStatus         ReplyVerificationStatus @default(UNVERIFIED)
  enabled                    Boolean                 @default(true)
  role                       ReplyDestinationRole    @default(PRIMARY)
  /**
   * Message categories this destination accepts
   */
  selectedCategories         Json                    @default("[\"all\"]")
  keepCopyInTap              Boolean                 @default(false)
  failureNotificationAddress String?
  /**
   * Capability flags as string[] — host UI never shows raw keys as primary copy
   */
  capabilities               Json                    @default("[]")
  /**
   * Credential reference key (env/vault pointer) — never the secret value
   */
  credentialRef              String?
  lastTestedAt               DateTime?
  lastTestResult             String?
  lastSuccessfulRouteAt      DateTime?
  lastFailureAt              DateTime?
  consecutiveFailureCount    Int                     @default(0)
  paused                     Boolean                 @default(false)
  pausedReason               String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  business           Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  verificationTokens ReplyVerificationToken[]
  routingAttempts    ReplyRoutingAttempt[]
  primaryPolicies    ReplyPolicy[]            @relation("ReplyPolicyPrimary")
  fallbackPolicies   ReplyPolicy[]            @relation("ReplyPolicyFallback")

  @@index([businessId, enabled])
  @@index([businessId, normalizedAddress])
  @@index([businessId, verificationStatus])
}

/**
 * Single-use destination verification tokens (hashed)
 */
model ReplyVerificationToken {
  id            String    @id @default(cuid())
  destinationId String
  businessId    String
  tokenHash     String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  destination ReplyDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([destinationId, createdAt])
  @@index([businessId, createdAt])
}

/**
 * Business default / Location override reply policy.
 * Campaign overrides live in Campaign.formSettings.emailResponse.replyHandling (JSON).
 */
model ReplyPolicy {
  id                         String            @id @default(cuid())
  businessId                 String
  locationId                 String?
  mode                       ReplyHandlingMode @default(TAP_ROUTE_EXTERNAL)
  primaryDestinationId       String?
  fallbackDestinationId      String?
  keepCopyInTap              Boolean           @default(false)
  notifyOnFailure            Boolean           @default(true)
  failureNotificationAddress String?
  useTapInboxFallback        Boolean           @default(true)
  activated                  Boolean           @default(false)
  activatedAt                DateTime?
  skipTestAcknowledged       Boolean           @default(false)
  metadata                   Json              @default("{}")
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  primaryDestination  ReplyDestination? @relation("ReplyPolicyPrimary", fields: [primaryDestinationId], references: [id], onDelete: SetNull)
  fallbackDestination ReplyDestination? @relation("ReplyPolicyFallback", fields: [fallbackDestinationId], references: [id], onDelete: SetNull)

  @@unique([businessId, locationId])
  @@index([businessId])
}

/**
 * Opaque reply+token@receiving-subdomain alias → context map
 */
model ReplyAlias {
  id                    String             @id @default(cuid())
  businessId            String
  /**
   * Public opaque token (not a DB id); hashed lookup key also stored
   */
  token                 String             @unique
  tokenHash             String             @unique
  campaignId            String?
  contactId             String?
  relationshipId        String?
  originatingMessageRef String?
  emailDocumentVersion  Int?
  replyPolicyMode       ReplyHandlingMode?
  destinationId         String?
  expiresAt             DateTime
  deactivatedAt         DateTime?
  metadata              Json               @default("{}")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, expiresAt])
  @@index([campaignId])
  @@index([contactId])
}

/**
 * Provider webhook / inbound event idempotency
 */
model ReplyProviderEvent {
  id              String   @id @default(cuid())
  businessId      String?
  provider        String   @default("resend")
  eventId         String
  receivedEmailId String?
  eventType       String
  processingState String   @default("received")
  payloadDigest   String?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([provider, receivedEmailId])
  @@index([businessId, createdAt])
}

/**
 * Canonical initial inbound reply (not a second Inbox)
 */
model ReplyInitialMessage {
  id                   String            @id @default(cuid())
  businessId           String
  locationId           String?
  contactId            String?
  relationshipId       String?
  campaignId           String?
  threadId             String?
  inboxMessageId       String?
  aliasId              String?
  provider             String            @default("resend")
  providerMessageId    String?
  internetMessageId    String?
  inReplyTo            String?
  referencesHeader     String?
  fromAddress          String
  toAddress            String
  replyAlias           String?
  subject              String?
  normalizedText       String
  sanitizedHtmlRef     String?
  receivedAt           DateTime
  attachmentMetadata   Json              @default("[]")
  classification       String?
  urgency              String?
  routingDestinationId String?
  routingState         ReplyRoutingState @default(RECEIVED)
  externalReference    String?
  evidenceClass        String            @default("confirmed")
  retentionState       String            @default("active")
  metadata             Json              @default("{}")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  routingAttempts ReplyRoutingAttempt[]

  @@unique([provider, providerMessageId])
  @@index([businessId, receivedAt])
  @@index([campaignId])
  @@index([threadId])
  @@index([routingState])
}

model ReplyRoutingAttempt {
  id               String   @id @default(cuid())
  businessId       String
  initialMessageId String?
  destinationId    String?
  attemptNumber    Int      @default(1)
  status           String
  idempotencyKey   String   @unique
  providerRef      String?
  errorCode        String?
  errorMessage     String?
  handoffKind      String?
  createdAt        DateTime @default(now())

  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  initialMessage ReplyInitialMessage? @relation(fields: [initialMessageId], references: [id], onDelete: SetNull)
  destination    ReplyDestination?    @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([destinationId, createdAt])
  @@index([initialMessageId])
}
