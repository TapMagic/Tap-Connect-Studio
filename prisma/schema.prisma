  @@index([businessId, createdAt])
}

model FusionIdempotencyRecord {
  id           String   @id @default(cuid())
  businessId   String
  operation    String
  key          String
  requestHash  String
  resourceType String?
  resourceId   String?
  response     Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([businessId, operation, key])
  @@index([expiresAt])
}

/**
 * Logical Tap Point — permanent public endpoint identity.
 * During bridge, code may equal DeviceSlot.deviceCode.
 */
model TapPoint {
  id           String               @id @default(cuid())
  businessId   String?
  name         String?
  status       FusionTapPointStatus @default(UNASSIGNED)
  /**
   * Bridge to V1 device inventory while DeviceUnit is introduced
   */
  deviceSlotId String?              @unique
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  address      TapPointAddress?
  publications PublicationSnapshot[]

  @@index([businessId, status])
}

model TapPointAddress {
  id         String   @id @default(cuid())
  tapPointId String   @unique
  /**
   * Opaque permanent public code — never rewrite for content changes
   */
  code       String   @unique
  createdAt  DateTime @default(now())

  tapPoint TapPoint @relation(fields: [tapPointId], references: [id], onDelete: Cascade)
}

/**
 * Immutable validated render snapshot for Card or Campaign Experience
 */
model PublicationSnapshot {
  id            String   @id @default(cuid())
  businessId    String
  /**
   * card | campaign | experience
   */
  subjectType   String
  subjectId     String
  version       Int
  schemaVersion Int      @default(1)
  manifest      Json
  contentHash   String
  publishedById String?
  publishedAt   DateTime @default(now())
  tapPointId    String?

  tapPoint TapPoint? @relation(fields: [tapPointId], references: [id], onDelete: SetNull)

  @@unique([subjectType, subjectId, version])
  @@unique([subjectType, subjectId, contentHash])
  @@index([businessId, publishedAt])
  @@index([tapPointId])
}

// ─── Audience domain (additive — V1 Lead remains authoritative during bridge) ─

enum FusionConsentChannel {
  EMAIL
  SMS
  WALLET
  MARKETING
}

enum FusionConsentStatus {
  GRANTED
  DENIED
  WITHDRAWN
}

enum FusionRelationshipStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutopilotProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  PARTIAL
  SUPERSEDED
  UNDONE
}

/**
 * Canonical person record scoped to a business workspace
 */
model Contact {
  id         String   @id @default(cuid())
  businessId String
  email      String?
  phone      String?
  name       String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business             Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  relationships        CustomerRelationship[]
  consents             ConsentRecord[]
  leads                Lead[]
  loyaltyEnrollments   LoyaltyEnrollment[]
  loyaltyLedgerEntries LoyaltyLedgerEntry[]

  @@index([businessId, createdAt])
  @@index([businessId, email])
  @@index([businessId, phone])
}

/**
 * Business ↔ contact link — MyTap uses publicToken, never PII in URLs
 */
model CustomerRelationship {
  id               String                   @id @default(cuid())
  businessId       String
  contactId        String
  /**
   * Opaque public identifier for /mytap/[relationshipId]
   */
  publicToken      String                   @unique @default(cuid())
  status           FusionRelationshipStatus @default(ACTIVE)
  sourceType       String?
  sourceLeadId     String?
  sourceTapPointId String?
  tapSaveEnabled   Boolean                  @default(false)
  metadata         Json                     @default("{}")
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  business             Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact              Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  moments              TapSaveMoment[]
  loyaltyEnrollments   LoyaltyEnrollment[]
  loyaltyLedgerEntries LoyaltyLedgerEntry[]

  @@unique([businessId, contactId])
  @@index([businessId, status])
}

model ConsentRecord {
  id         String               @id @default(cuid())
  businessId String
  contactId  String
  channel    FusionConsentChannel
  status     FusionConsentStatus
  legalBasis String?
  sourceType String?
  sourceId   String?
  recordedAt DateTime             @default(now())
  metadata   Json                 @default("{}")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, channel])
  @@index([businessId, recordedAt])
}

/**
 * TapSave relationship moments — retention timeline for MyTap
 */
model TapSaveMoment {
  id             String   @id @default(cuid())
  businessId     String
  relationshipId String
  visitorRef     String?
  kind           String
  campaignId     String?
  deviceSlotId   String?
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now())

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  relationship CustomerRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([relationshipId, occurredAt])
  @@index([businessId, occurredAt])
  @@index([businessId, kind])
}

/**
 * Autopilot / Automation Team proposals — durable review lifecycle
 */
model AutopilotProposal {
  id                    String                   @id @default(cuid())
  businessId            String
  recipeId              String
  mode                  String
  status                AutopilotProposalStatus  @default(PENDING)
  prompt                String
  summary               String
  artifacts             Json                     @default("[]")
  warnings              Json                     @default("[]")
  /**
   * Artifact kinds accepted on PARTIAL (empty when full accept)
   */
  acceptedArtifactKinds Json                     @default("[]")
  previousStatus        AutopilotProposalStatus?
  actorId               String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  decidedAt             DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, status])
}

