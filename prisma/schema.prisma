  documentId       String
  nodeId           String
  workItemId       String
  provider         String
  externalId       String?
  title            String
  status           String?
  syncStatus       String?
  lastSyncedAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  document TapCanvasDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

