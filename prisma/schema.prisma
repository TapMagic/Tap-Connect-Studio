  nodeId      String?
  evidence    Json     @default("{}")
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  document TapCanvasDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

