  resource CreativeResource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  revision CreativeResourceRevision @relation(fields: [resourceRevisionId], references: [id], onDelete: Restrict)

  @@unique([businessId, surface, subjectId, documentPath], map: "creative_resource_usage_subject_path_key")
  @@index([businessId, resourceId])
  @@index([businessId, resourceRevisionId])
}

model CreativeResourceFavorite {
