generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  MARKETING
  STAFF_SCANNER
  VIEWER
}

enum PlanTier {
  BASIC
  STUDIO
  PRO
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum DeviceStatus {
  UNASSIGNED
  ACTIVE
  INACTIVE
  ARCHIVED
  LOST
  REPLACED
  SUSPENDED
  CLOSED
  RETIRED
}

enum DeviceType {
  BUSINESS_CARD
  PRODUCT_DISC
  SHELF_TAG
  TABLE_TENT
  WINDOW_SIGN
  EVENT_SIGN
  PACKAGE_INSERT
  REVIEW_STAND
  STAFF_INTERNAL
  GENERIC_NFC
}

enum AuthMode {
  STANDARD
  LOCKED_STANDARD
  VERIFIED
  MANUAL
  INTERNAL_TEST
}

enum CampaignStatus {
  DRAFT
  READY
  SCHEDULED
  LIVE
  PAUSED
  ARCHIVED
  CLOSED
}

enum CampaignType {
  PRODUCT_STORY
  VIDEO_DEMO
  COUPON_OFFER
  REVIEW_REQUEST
  FEEDBACK_FORM
  CONTACT_VCARD
  EVENT_ANNOUNCEMENT
  STAFF_PICK
  LINK_HUB
  MENU_INFO
  MULTI_LOCATION
  LEAD_CAPTURE
}

enum AssignmentStatus {
  SCHEDULED
  ACTIVE
  ENDED
  REPLACED
  CANCELED
}

enum ScanSessionStatus {
  WAITING
  SCANNED
  EXPIRED
  CANCELED
}

enum ScanSessionType {
  OWNER_PHONE
  DESKTOP_PHONE
  REMOTE_STAFF
  SUPPORT_ASSISTED
}

enum ComplianceCategory {
  GENERAL
  TOBACCO
  VAPE
  CANNABIS
  ALCOHOL
  SUPPLEMENTS
  HEALTH_WELLNESS
  WEAPONS
  ADULT
  FINANCIAL
  MEDICAL
}

enum FontStyle {
  MODERN
  CLASSIC
  PLAYFUL
  PREMIUM
  MINIMAL
}

enum ButtonStyle {
  ROUNDED
  PILL
  SHARP
  SOFT
}

enum MediaApprovalStatus {
  UNREVIEWED
  APPROVED
  REJECTED
}

enum MediaLicenseCode {
  OWNER_SUPPLIED
  PEXELS
  NO_LICENSE_ASSERTED
  EXTERNAL_UNVERIFIED
  OTHER
}

enum CreativeSurfaceKind {
  CARD
  EMAIL
  CAMPAIGN
  SPOTLIGHT
  OFFER
  COUPON
}

enum CreativeResourceKind {
  COMPOSITION
  TEXT_STYLE
  BUTTON_STYLE
  FRAME_TREATMENT
  GRADIENT
  BACKGROUND
  PALETTE
  MASK_FAVORITES
  OFFER_LAYOUT
  COUPON_LAYOUT
  EMAIL_SECTION
  CAMPAIGN_SECTION
  TEMPLATE
}

enum CreativeResourceStatus {
  DRAFT
  APPROVED
  DEPRECATED
}

enum BusinessCategory {
  PROFESSIONAL_SERVICES
  HEALTH_WELLNESS
  FOOD_HOSPITALITY
  RETAIL_ECOMMERCE
  HOME_LOCAL_SERVICES
  REAL_ESTATE
  NONPROFIT_COMMUNITY
  CREATOR_PERSONAL_BRAND
  OTHER
}

enum CustomerOutcome {
  CONTACT
  REVIEWS
  OFFER
  APPOINTMENTS
  DIRECTIONS
  ESSENTIALS
  LOYALTY
  FAQ
}

enum KnowledgeSourceKind {
  OWNER
  WEBSITE
  UPLOAD
  SOCIAL
  BRAND_ASSET
  SYSTEM
}

enum KnowledgeIngestionStatus {
  PENDING
  READY
  PARTIAL
  FAILED
}

enum KnowledgeApprovalStatus {
  SUGGESTED
  APPROVED
  REJECTED
  STALE
}

enum KnowledgeContradictionStatus {
  NONE
  SUSPECTED
  CONFIRMED
}

enum KnowledgeEvidenceClass {
  HOST_DECLARED
  SYSTEM_OBSERVED
  DERIVED
  INFERRED
}

enum BrandDecisionStatus {
  SUGGESTED
  KEPT
  APPROVED
  REJECTED
  IGNORED
  REPLACED
}

enum BrandDecisionScope {
  BRAND
  CARD_ONLY
}

enum BrandRightsStatus {
  CONFIRMED
  NEEDS_CONFIRMATION
  NOT_APPLICABLE
}

enum PlatformUserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
  DELETION_SCHEDULED
}

enum PlatformDeletionState {
  NONE
  SCHEDULED
  BLOCKED_BY_HOLD
  RETAINED_TOMBSTONE
}

enum WorkspaceKind {
  CUSTOMER
  INTERNAL
  PERSONAL_SANDBOX
  DEMO
  PARTNER
  TEST_FIXTURE
}

enum BusinessLifecycleState {
  PROVISIONING
  TRIAL
  ACTIVE
  PAST_DUE
  RESTRICTED
  SUSPENDED
  CANCELLED
  ARCHIVED
  DELETION_SCHEDULED
  DELETED
  LEGAL_HOLD
}

enum PlatformRoleStatus {
  ACTIVE
  RETIRED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum PlatformInvitationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  EXPIRED
  REVOKED
  FAILED
}

enum PlatformSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SupportSessionStatus {
  ACTIVE
  EXITED
  EXPIRED
  REVOKED
}

enum CatalogStatus {
  ACTIVE
  RETIRED
}

enum ServiceAvailability {
  INTERNAL
  PRIVATE_BETA
  PUBLIC
}

enum EntitlementOverrideStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  CANCELLED
  BLOCKED
  GRACE_PERIOD
  READY
  APPLIED
  FAILED
}

enum DemoVisibility {
  PRIVATE
  SHARED
}

enum DemoPromotionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum DemoPublicationStatus {
  DRAFT
  PUBLISHED
  ROLLED_BACK
  UNPUBLISHED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  APPLIED
  FAILED
}

// ─── Users & Business ────────────────────────────────────────────────────────

model User {
  id                       String                @id @default(cuid())
  clerkId                  String?               @unique
  email                    String                @unique
  firstName                String?
  lastName                 String?
  displayName              String?
  imageUrl                 String?
  profilePhotoMediaAssetId String?
  profilePhotoAlt          String?
  platformStatus           PlatformUserStatus    @default(ACTIVE)
  preferredTimezone        String                @default("America/New_York")
  locale                   String                @default("en-US")
  lastSeenAt               DateTime?
  lastActiveWorkspaceId    String?
  archivedAt               DateTime?
  deletionState            PlatformDeletionState @default(NONE)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  memberships               BusinessUser[]
  campaignsCreated          Campaign[]                 @relation("CampaignCreatedBy")
  campaignsUpdated          Campaign[]                 @relation("CampaignUpdatedBy")
  assignmentsMade           DeviceAssignment[]
  scanSessions              ScanSession[]
  approvedMediaAssets       MediaAsset[]               @relation("MediaAssetApprovedBy")
  mediaAssetFavorites       MediaAssetFavorite[]
  mediaAssetRecents         MediaAssetRecent[]
  creativeResourcesCreated  CreativeResource[]         @relation("CreativeResourceCreatedBy")
  creativeResourcesUpdated  CreativeResource[]         @relation("CreativeResourceUpdatedBy")
  creativeResourcesApproved CreativeResource[]         @relation("CreativeResourceApprovedBy")
  creativeResourceRevisions CreativeResourceRevision[]
  creativeResourceFavorites CreativeResourceFavorite[]
  creativeResourceRecents   CreativeResourceRecent[]
  profilePhoto              MediaAsset?                @relation("PlatformUserProfilePhoto", fields: [profilePhotoMediaAssetId], references: [id], onDelete: SetNull)
  platformRoleBindings      PlatformRoleBinding[]
  platformDirectPermissions PlatformDirectPermission[]
  platformSessions          PlatformSession[]
  presenceHeartbeats        PresenceHeartbeat[]
  supportSessionsStarted    SupportSession[]           @relation("SupportSessionActor")
  supportSessionsReceived   SupportSession[]           @relation("SupportSessionSubject")
  demoMetadataOwned         DemoWorkspaceMetadata[]    @relation("DemoOwner")
  demoManagerBindings       DemoManager[]
  internalNotesAuthored     InternalNote[]             @relation("InternalNoteAuthor")

  @@index([platformStatus, lastSeenAt])
}

model Business {
  id                             String                 @id @default(cuid())
  name                           String
  slug                           String                 @unique
  logoUrl                        String?
  website                        String?
  phone                          String?
  email                          String?
  googleReviewUrl                String?
  /**
   * IANA timezone, e.g. America/New_York — used when a group has no timezone set
   */
  timezone                       String                 @default("America/New_York")
  complianceCategory             ComplianceCategory     @default(GENERAL)
  subscriptionTier               PlanTier               @default(BASIC)
  activeDeviceLimit              Int                    @default(1)
  activeCampaignLimit            Int                    @default(3)
  billingStatus                  SubscriptionStatus     @default(INCOMPLETE)
  stripeCustomerId               String?                @unique
  businessCategory               BusinessCategory?
  primaryCustomerOutcome         CustomerOutcome?
  cardFirstOnboardingPreviewedAt DateTime?
  cardFirstOnboardingCompletedAt DateTime?
  workspaceKind                  WorkspaceKind          @default(CUSTOMER)
  lifecycleState                 BusinessLifecycleState @default(ACTIVE)
  planDefinitionId               String?
  archivedAt                     DateTime?
  deletionScheduledAt            DateTime?
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt

  users                     BusinessUser[]
  brandKit                  BrandKit?
  locations                 Location[]
  devices                   DeviceSlot[]
  campaigns                 Campaign[]
  campaignGroups            CampaignGroup[]
  assignments               DeviceAssignment[]
  leads                     Lead[]
  tapEvents                 TapEvent[]
  clickEvents               ClickEvent[]
  scanSessions              ScanSession[]
  subscription              Subscription?
  mediaAssets               MediaAsset[]
  mediaAssetFavorites       MediaAssetFavorite[]
  mediaAssetRecents         MediaAssetRecent[]
  mediaCollections          MediaCollection[]
  mediaCollectionMembers    MediaCollectionMember[]
  creativeAssetUsages       CreativeAssetUsage[]
  creativeResources         CreativeResource[]
  creativeResourceUsages    CreativeResourceUsage[]
  creativeResourceFavorites CreativeResourceFavorite[]
  creativeResourceRecents   CreativeResourceRecent[]
  savedTemplates            SavedTemplate[]
  journeyDrafts             JourneyDraft[]
  journeyPublishedVersions  JourneyPublishedVersion[]
  journeyExecutions         JourneyExecution[]
  journeyProviderEvents     JourneyProviderEvent[]
  scheduleRules             ScheduleRule[]
  groupSlots                CampaignGroupSlot[]
  brandLinks                BrandLink[]
  contacts                  Contact[]
  customerRelationships     CustomerRelationship[]
  consentRecords            ConsentRecord[]
  walletPasses              WalletPass[]
  messageThreads            MessageThread[]
  tapCases                  TapCase[]
  suppressions              CommunicationSuppression[]
  tapSaveMoments            TapSaveMoment[]
  autopilotProposals        AutopilotProposal[]
  loyaltyPrograms           LoyaltyProgram[]
  loyaltyEnrollments        LoyaltyEnrollment[]
  loyaltyLedgerEntries      LoyaltyLedgerEntry[]
  tapCanvasDocuments        TapCanvasDocument[]
  tikTokCasts               TikTokCast[]
  tikTokConnection          TikTokConnection?
  tikTokAuditLogs           TikTokAuditLog[]
  tapCastChannelVariants    TapCastChannelVariant[]
  tapCastChannelConnections TapCastChannelConnection[]
  tapCastAuditLogs          TapCastAuditLog[]
  brandVocabularyTerms      BrandVocabularyTerm[]
  brandVocabularyPacks      BrandVocabularyPack[]
  vocabularySuggestionRuns  VocabularySuggestionRun[]
  vocabularyAnalyticsEvents VocabularyAnalyticsEvent[]
  vocabularyTriggerBindings VocabularyTriggerBinding[]
  replyDestinations         ReplyDestination[]
  replyPolicies             ReplyPolicy[]
  replyAliases              ReplyAlias[]
  replyProviderEvents       ReplyProviderEvent[]
  replyRoutingAttempts      ReplyRoutingAttempt[]
  replyInitialMessages      ReplyInitialMessage[]
  knowledgeSources          KnowledgeSource[]
  knowledgeFacts            KnowledgeFact[]
  brandPropertyDecisions    BrandPropertyDecision[]
  planDefinition            PlanDefinition?               @relation(fields: [planDefinitionId], references: [id], onDelete: SetNull)
  entitlementOverrides      BusinessEntitlementOverride[]
  accountRestrictions       AccountRestriction[]
  deletionRequests          DeletionRequest[]
  legalHolds                LegalHold[]
  demoMetadata              DemoWorkspaceMetadata?
  landingDemoBindings       LandingDemoBinding[]
  controlInternalNotes      InternalNote[]

  @@index([workspaceKind, lifecycleState])
  @@index([lifecycleState, deletionScheduledAt])
}

model BusinessUser {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       UserRole @default(OWNER)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
}

// ─── Platform Control Room ──────────────────────────────────────────────────

model PlatformRole {
  id                String             @id @default(cuid())
  key               String             @unique
  name              String             @unique
  description       String
  status            PlatformRoleStatus @default(ACTIVE)
  protected         Boolean            @default(false)
  ownerRole         Boolean            @default(false)
  createdById       String?
  retiredAt         DateTime?
  replacementRoleId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  permissions     PlatformRolePermission[]
  bindings        PlatformRoleBinding[]
  invitations     PlatformInvitation[]
  replacementRole PlatformRole?            @relation("PlatformRoleReplacement", fields: [replacementRoleId], references: [id], onDelete: SetNull)
  replacedRoles   PlatformRole[]           @relation("PlatformRoleReplacement")

  @@index([status, name])
}

model PlatformRolePermission {
  id            String           @id @default(cuid())
  roleId        String
  permissionKey String
  effect        PermissionEffect @default(ALLOW)
  createdAt     DateTime         @default(now())

  role PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([permissionKey, effect])
}

model PlatformRoleBinding {
  id               String    @id @default(cuid())
  userId           String
  roleId           String
  environmentScope String    @default("*")
  businessId       String    @default("*")
  grantedById      String?
  reason           String
  startsAt         DateTime  @default(now())
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role PlatformRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, environmentScope, businessId])
  @@index([userId, expiresAt])
  @@index([businessId])
}

model PlatformDirectPermission {
  id               String           @id @default(cuid())
  userId           String
  permissionKey    String
  effect           PermissionEffect
  environmentScope String           @default("*")
  businessId       String           @default("*")
  reason           String
  grantedById      String?
  startsAt         DateTime         @default(now())
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey, environmentScope, businessId])
  @@index([userId, effect, expiresAt])
  @@index([permissionKey])
}

model PlatformInvitation {
  id                    String                   @id @default(cuid())
  email                 String
  displayName           String
  roleId                String
  status                PlatformInvitationStatus @default(DRAFT)
  tokenHash             String?                  @unique
  environmentScope      String                   @default("*")
  expiresAt             DateTime
  internalNote          String?
  requireMfa            Boolean                  @default(true)
  createSandbox         Boolean                  @default(true)
  demoPortfolioAccess   Boolean                  @default(false)
  createdById           String
  sentAt                DateTime?
  viewedAt              DateTime?
  acceptedAt            DateTime?
  acceptedByClerkUserId String?
  revokedAt             DateTime?
  failedReason          String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  role                PlatformRole                      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissions         PlatformInvitationPermission[]
  businessScopes      PlatformInvitationBusinessScope[]
  businessMemberships PlatformInvitationMembership[]

  @@index([status, expiresAt])
  @@index([email, status])
}

model PlatformInvitationPermission {
  id            String           @id @default(cuid())
  invitationId  String
  permissionKey String
  effect        PermissionEffect

  invitation PlatformInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, permissionKey])
}

model PlatformInvitationBusinessScope {
  id           String @id @default(cuid())
  invitationId String
  businessId   String

  invitation PlatformInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, businessId])
  @@index([businessId])
}

model PlatformInvitationMembership {
  id           String   @id @default(cuid())
  invitationId String
  businessId   String
  role         UserRole @default(VIEWER)

  invitation PlatformInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, businessId])
  @@index([businessId])
}

model PlatformSession {
  id                       String                @id @default(cuid())
  userId                   String
  externalSessionId        String?               @unique
  status                   PlatformSessionStatus @default(ACTIVE)
  deviceSummary            String?
  browserSummary           String?
  ipAddressRedacted        String?
  currentWorkspaceId       String?
  currentArea              String?
  startedAt                DateTime              @default(now())
  lastSeenAt               DateTime              @default(now())
  revokedAt                DateTime?
  revokedById              String?
  reauthenticationRequired Boolean               @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, lastSeenAt])
  @@index([status, lastSeenAt])
}

model PresenceHeartbeat {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String
  workspaceId String?
  majorArea   String?
  occurredAt  DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([sessionId, occurredAt])
}

model SupportSession {
  id                   String               @id @default(cuid())
  actorUserId          String
  subjectUserId        String
  businessId           String?
  externalActorTokenId String?
  reason               String
  status               SupportSessionStatus @default(ACTIVE)
  startedAt            DateTime             @default(now())
  expiresAt            DateTime
  endedAt              DateTime?
  endedById            String?
  localFixture         Boolean              @default(false)
  createdAt            DateTime             @default(now())

  actor   User @relation("SupportSessionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  subject User @relation("SupportSessionSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, status, expiresAt])
  @@index([subjectUserId, status])
  @@index([businessId, status])
}

model ServiceDefinition {
  id              String              @id @default(cuid())
  key             String              @unique
  ownerFacingName String
  description     String
  category        String
  availability    ServiceAvailability @default(INTERNAL)
  usageUnit       String?
  defaultEnabled  Boolean             @default(false)
  customerVisible Boolean             @default(false)
  diagnosticsPath String?
  status          CatalogStatus       @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  dependencies     ServiceDependency[]           @relation("DependentService")
  dependedOnBy     ServiceDependency[]           @relation("RequiredService")
  planEntitlements PlanEntitlement[]
  overrides        BusinessEntitlementOverride[]
  restrictions     AccountRestriction[]

  @@index([status, category])
}

model ServiceDependency {
  id                String @id @default(cuid())
  serviceId         String
  requiredServiceId String

  service         ServiceDefinition @relation("DependentService", fields: [serviceId], references: [id], onDelete: Cascade)
  requiredService ServiceDefinition @relation("RequiredService", fields: [requiredServiceId], references: [id], onDelete: Restrict)

  @@unique([serviceId, requiredServiceId])
}

model PlanDefinition {
  id                     String        @id @default(cuid())
  key                    String        @unique
  name                   String        @unique
  description            String
  status                 CatalogStatus @default(ACTIVE)
  tapPointAllowance      Int           @default(0)
  locationAllowance      Int           @default(1)
  storageAllowanceBytes  BigInt        @default(0)
  campaignAllowance      Int           @default(0)
  emailAllowance         Int           @default(0)
  aiAllowance            Int           @default(0)
  trialDays              Int           @default(0)
  upgradePathKey         String?
  grandfatheringBehavior String        @default("preserve")
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  entitlements PlanEntitlement[]
  businesses   Business[]

  @@index([status, name])
}

model PlanEntitlement {
  id        String  @id @default(cuid())
  planId    String
  serviceId String
  enabled   Boolean @default(true)
  allowance Int?

  plan    PlanDefinition    @relation(fields: [planId], references: [id], onDelete: Cascade)
  service ServiceDefinition @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([planId, serviceId])
  @@index([serviceId, enabled])
}

model BusinessEntitlementOverride {
  id                  String                    @id @default(cuid())
  businessId          String
  serviceId           String
  enabled             Boolean?
  allowance           Int?
  grantKind           String
  startsAt            DateTime                  @default(now())
  expiresAt           DateTime?
  reason              String
  billingImpact       String?
  customerVisibleNote String?
  internalNote        String?
  grantedById         String
  approvalId          String?
  status              EntitlementOverrideStatus @default(ACTIVE)
  revokedAt           DateTime?
  revokedById         String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  ServiceDefinition @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([businessId, status, expiresAt])
  @@index([serviceId, status])
}

model AccountRestriction {
  id                         String    @id @default(cuid())
  businessId                 String
  userId                     String?
  serviceId                  String?
  capability                 String
  reason                     String
  internalNote               String?
  customerVisibleExplanation String?
  startsAt                   DateTime  @default(now())
  expiresAt                  DateTime?
  createdById                String
  approvalId                 String?
  revokedAt                  DateTime?
  revokedById                String?
  createdAt                  DateTime  @default(now())

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  ServiceDefinition? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([businessId, capability, expiresAt])
  @@index([userId, expiresAt])
}

model DeletionRequest {
  id                  String                @id @default(cuid())
  targetType          String
  targetId            String
  businessId          String?
  requestedById       String
  reason              String
  consequence         String
  retentionExceptions String?
  graceEndsAt         DateTime
  status              DeletionRequestStatus @default(PENDING)
  approvalId          String?
  cancelledAt         DateTime?
  cancelledById       String?
  appliedAt           DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, status])
  @@index([businessId, status])
  @@index([status, graceEndsAt])
}

model LegalHold {
  id           String    @id @default(cuid())
  businessId   String
  reason       String
  authority    String
  placedById   String
  placedAt     DateTime  @default(now())
  releasedAt   DateTime?
  releasedById String?
  approvalId   String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, releasedAt])
}

model DemoWorkspaceMetadata {
  id                   String              @id @default(cuid())
  businessId           String              @unique
  description          String
  industryUseCase      String
  ownerUserId          String
  visibility           DemoVisibility      @default(PRIVATE)
  promotionStatus      DemoPromotionStatus @default(DRAFT)
  allowedPublicActions String[]            @default([])
  blockedActions       String[]            @default([])
  resetPolicy          String              @default("manual")
  standaloneSlug       String              @unique
  fixtureProvenance    String
  currentPublicationId String?
  lastResetAt          DateTime?
  lastResetById        String?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewNote           String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  owner           User                 @relation("DemoOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  managers        DemoManager[]
  publications    DemoPublication[]
  landingBindings LandingDemoBinding[]

  @@index([visibility, promotionStatus])
  @@index([ownerUserId, visibility])
}

model DemoManager {
  id             String @id @default(cuid())
  demoMetadataId String
  userId         String

  demoMetadata DemoWorkspaceMetadata @relation(fields: [demoMetadataId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([demoMetadataId, userId])
  @@index([userId])
}

model DemoPublication {
  id                    String                @id @default(cuid())
  demoMetadataId        String
  publicationSnapshotId String
  version               Int
  status                DemoPublicationStatus @default(DRAFT)
  readinessPassed       Boolean               @default(false)
  readinessSummary      String
  contentHash           String
  publishedById         String?
  publishedAt           DateTime?
  rolledBackFromId      String?
  unpublishedAt         DateTime?
  createdAt             DateTime              @default(now())

  demoMetadata DemoWorkspaceMetadata @relation(fields: [demoMetadataId], references: [id], onDelete: Cascade)

  @@unique([demoMetadataId, version])
  @@unique([publicationSnapshotId])
  @@index([demoMetadataId, status, publishedAt])
}

model LandingDemoBinding {
  id                  String    @id @default(cuid())
  slotKey             String
  businessId          String
  demoMetadataId      String
  demoPublicationId   String
  active              Boolean   @default(false)
  activatedById       String?
  activatedAt         DateTime?
  deactivatedAt       DateTime?
  priorBindingId      String?
  rollbackOfBindingId String?
  createdAt           DateTime  @default(now())

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  demoMetadata DemoWorkspaceMetadata @relation(fields: [demoMetadataId], references: [id], onDelete: Restrict)

  @@index([slotKey, active, activatedAt])
  @@index([demoPublicationId])
}

model ApprovalRequest {
  id                   String                @id @default(cuid())
  actionKey            String
  targetType           String
  targetId             String
  requesterId          String
  reason               String
  consequence          String
  requiredApproverRole String
  separationRequired   Boolean               @default(true)
  status               ApprovalRequestStatus @default(PENDING)
  expiresAt            DateTime
  decidedById          String?
  decidedAt            DateTime?
  decisionNote         String?
  appliedAt            DateTime?
  failureReason        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([status, expiresAt])
  @@index([targetType, targetId])
  @@index([requesterId, status])
}

model InternalNote {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  businessId String?
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author   User      @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([businessId, createdAt])
}

model PlatformConfiguration {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String
  updatedById String?
  reason      String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Location {
  id         String   @id @default(cuid())
  businessId String
  name       String
  address    String?
  city       String?
  state      String?
  zip        String?
  phone      String?
  mapUrl     String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  devices          DeviceSlot[]
  knowledgeSources KnowledgeSource[]
  knowledgeFacts   KnowledgeFact[]
}

// ─── Brand Kit ───────────────────────────────────────────────────────────────

model BrandKit {
  id                    String      @id @default(cuid())
  businessId            String      @unique
  primaryColor          String      @default("#22c55e")
  secondaryColor        String      @default("#0ea5e9")
  accentColor           String      @default("#f59e0b")
  backgroundColor       String      @default("#0b0f19")
  textColor             String      @default("#f8fafc")
  fontStyle             FontStyle   @default(MODERN)
  buttonStyle           ButtonStyle @default(ROUNDED)
  defaultLanguage       String      @default("en")
  tone                  String      @default("professional")
  defaultDisclaimer     String?
  ageGateEnabled        Boolean     @default(false)
  ageGateMinAge         Int         @default(21)
  socialLinks           Json        @default("{}")
  defaultFooter         Json        @default("[]")
  /**
   * Default orphan-tag end page (same shape as EndExperience)
   */
  endExperience         Json        @default("{}")
  /**
   * Lead follow-up promo email template
   */
  emailPromo            Json        @default("{}")
  /**
   * Extra custom links: [{ title, description, iconUrl, href }] — legacy JSON
   */
  otherLinks            Json        @default("[]")
  /**
   * Tap Connect Card layout — flexible digital business card
   */
  tapCard               Json        @default("{}")
  /**
   * Saved Card draft. Draft writes never mutate tapCard or publication state.
   */
  tapCardDraft          Json?
  tapCardDraftUpdatedAt DateTime?
  tapCardDraftRevision  Int         @default(0)
  tapCardPublishedAt    DateTime?
  /**
   * Legacy keyword Brand Pack JSON — mirrored from BrandVocabularyTerm for compatibility
   */
  keywordBrandPack      Json        @default("{}")
  /**
   * Last / default library icon selected in the Brand Kit IconPicker
   */
  iconName              String?
  /**
   * Hex color for the Brand Kit default icon
   */
  iconColor             String      @default("#000000")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  business          Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  links             BrandLink[]
  vocabularyTerms   BrandVocabularyTerm[]
  vocabularyPacks   BrandVocabularyPack[]
  propertyDecisions BrandPropertyDecision[]
}

// ─── Governed Business Knowledge & Brand decisions ──────────────────────────

model KnowledgeSource {
  id                 String                   @id @default(cuid())
  businessId         String
  locationId         String?
  mediaAssetId       String?
  kind               KnowledgeSourceKind
  normalizedUri      String?
  displayLabel       String
  contentHash        String?
  requestFingerprint String?
  ingestionStatus    KnowledgeIngestionStatus @default(PENDING)
  rightsNote         String?
  metadata           Json                     @default("{}")
  capturedAt         DateTime                 @default(now())
  lastVerifiedAt     DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  business       Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location       Location?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  mediaAsset     MediaAsset?             @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  facts          KnowledgeFact[]
  brandDecisions BrandPropertyDecision[]

  @@unique([businessId, kind, requestFingerprint])
  @@index([businessId, kind])
  @@index([businessId, normalizedUri])
  @@index([mediaAssetId])
}

model KnowledgeFact {
  id                  String                       @id @default(cuid())
  businessId          String
  locationId          String?
  sourceId            String
  factKey             String
  value               Json
  confidence          Float
  approvalStatus      KnowledgeApprovalStatus      @default(SUGGESTED)
  contradictionStatus KnowledgeContradictionStatus @default(NONE)
  contradictionGroup  String?
  evidenceClass       KnowledgeEvidenceClass
  whereUsed           Json                         @default("[]")
  version             Int                          @default(1)
  supersedesId        String?
  approvedById        String?
  approvedAt          DateTime?
  lastVerifiedAt      DateTime
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location   Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  source     KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  supersedes KnowledgeFact?  @relation("KnowledgeFactVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  revisions  KnowledgeFact[] @relation("KnowledgeFactVersions")

  @@index([businessId, factKey, approvalStatus])
  @@index([sourceId])
  @@index([locationId])
  @@index([supersedesId])
}

model BrandPropertyDecision {
  id                 String              @id @default(cuid())
  businessId         String
  brandKitId         String
  propertyKey        String
  candidate          Json
  status             BrandDecisionStatus @default(SUGGESTED)
  scope              BrandDecisionScope  @default(BRAND)
  locked             Boolean             @default(false)
  lockedAt           DateTime?
  knowledgeSourceId  String?
  mediaAssetId       String?
  provider           String?
  confidence         Float?
  rationale          String?
  rightsStatus       BrandRightsStatus   @default(NOT_APPLICABLE)
  replacesDecisionId String?
  actedById          String?
  approvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  business        Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  brandKit        BrandKit                @relation(fields: [brandKitId], references: [id], onDelete: Cascade)
  knowledgeSource KnowledgeSource?        @relation(fields: [knowledgeSourceId], references: [id], onDelete: SetNull)
  mediaAsset      MediaAsset?             @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  replaces        BrandPropertyDecision?  @relation("BrandDecisionVersions", fields: [replacesDecisionId], references: [id], onDelete: SetNull)
  replacements    BrandPropertyDecision[] @relation("BrandDecisionVersions")

  @@index([brandKitId, propertyKey, status])
  @@index([businessId, propertyKey])
  @@index([mediaAssetId])
  @@index([knowledgeSourceId])
}

/**
 * Normalized brand / social / custom links with persisted icon + color
 */
model BrandLink {
  id          String   @id @default(cuid())
  businessId  String
  brandKitId  String?
  title       String   @default("")
  description String?
  href        String   @default("")
  /**
   * Library icon id from IconPicker (e.g. "home", "slack")
   */
  iconName    String?
  /**
   * Custom hex tint from IconPicker
   */
  iconColor   String   @default("#000000")
  /**
   * Preferred logo / image mark when set
   */
  logoUrl     String?
  platform    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  brandKit BrandKit? @relation(fields: [brandKitId], references: [id], onDelete: SetNull)

  @@index([businessId])
}

// ─── Subscription ────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  businessId           String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  tier                 PlanTier           @default(BASIC)
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ─── Devices ─────────────────────────────────────────────────────────────────

model DeviceSlot {
  id              String       @id @default(cuid())
  businessId      String?
  deviceCode      String       @unique
  deviceType      DeviceType   @default(GENERIC_NFC)
  status          DeviceStatus @default(UNASSIGNED)
  authMode        AuthMode     @default(STANDARD)
  nickname        String?
  locationId      String?
  locationNote    String?
  totalTapCount   Int          @default(0)
  lastTappedAt    DateTime?
  issuedAt        DateTime     @default(now())
  activatedAt     DateTime?
  batchId         String?
  metadata        Json         @default("{}")
  /**
   * When set, tap resolves via this group's schedule (shared across all table/bar tags)
   */
  campaignGroupId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business      Business?          @relation(fields: [businessId], references: [id], onDelete: SetNull)
  location      Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  campaignGroup CampaignGroup?     @relation(fields: [campaignGroupId], references: [id], onDelete: SetNull)
  assignments   DeviceAssignment[]
  tapEvents     TapEvent[]
  leads         Lead[]
  clickEvents   ClickEvent[]
  scheduleRules ScheduleRule[]
}

// ─── Campaigns ───────────────────────────────────────────────────────────────

model Campaign {
  id                 String         @id @default(cuid())
  businessId         String
  title              String
  campaignType       CampaignType
  status             CampaignStatus @default(DRAFT)
  templateId         String?
  contentBlocks      Json           @default("[]")
  primaryMedia       Json           @default("{}")
  offerSettings      Json           @default("{}")
  formSettings       Json           @default("{}")
  complianceSettings Json           @default("{}")
  themeOverrides     Json           @default("{}")
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  /**
   * After schedule ends — contact opportunity (EndExperience JSON)
   */
  endExperience      Json           @default("{}")
  /**
   * When true (admin only), this card/campaign powers the public landing live demo
   */
  isLandingDemo      Boolean        @default(false)
  /**
   * Optional parent group — this campaign is a scheduled “special” in the group
   */
  groupId            String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  group            CampaignGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy        User?               @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?               @relation("CampaignUpdatedBy", fields: [updatedById], references: [id])
  assignments      DeviceAssignment[]
  leads            Lead[]
  tapEvents        TapEvent[]
  clickEvents      ClickEvent[]
  mediaAssets      MediaAsset[]
  scheduleRules    ScheduleRule[]
  groupSlots       CampaignGroupSlot[]
  defaultForGroups CampaignGroup[]     @relation("GroupDefaultCampaign")
  endForGroups     CampaignGroup[]     @relation("GroupEndCampaign")
}

/**
 * Shared schedule hub — many devices share one rotating set of timed pages.
 */
model CampaignGroup {
  id                  String         @id @default(cuid())
  businessId          String
  title               String
  description         String?
  status              CampaignStatus @default(LIVE)
  /**
   * IANA timezone for day/time matching (falls back to business.timezone)
   */
  timezone            String?
  /**
   * When true, tap pages from this group can show an upcoming schedule strip
   */
  showUpcomingOnPages Boolean        @default(true)
  /**
   * Optional industry hint for starter seeds / copy (hospitality, salon, wedding, …)
   */
  industryHint        String?
  /**
   * Shown when no slot matches the current day/time
   */
  defaultCampaignId   String?
  /**
   * End / “offer over” page — normal campaign used when nothing else matches
   */
  endCampaignId       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  defaultCampaign Campaign?           @relation("GroupDefaultCampaign", fields: [defaultCampaignId], references: [id], onDelete: SetNull)
  endCampaign     Campaign?           @relation("GroupEndCampaign", fields: [endCampaignId], references: [id], onDelete: SetNull)
  campaigns       Campaign[]
  slots           CampaignGroupSlot[]
  devices         DeviceSlot[]

  @@index([businessId])
}

/**
 * One timed page inside a group (weekday offer, weekend promo, after-hours consult, etc.)
 */
model CampaignGroupSlot {
  id         String   @id @default(cuid())
  businessId String
  groupId    String
  campaignId String
  label      String
  daysOfWeek Json     @default("[]") // [1,2,3,4,5] Mon=1
  startTime  String? // "16:00"
  endTime    String? // "23:59"
  priority   Int      @default(0)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  group    CampaignGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([groupId, enabled])
}

model DeviceAssignment {
  id                   String           @id @default(cuid())
  deviceSlotId         String
  campaignId           String
  businessId           String
  status               AssignmentStatus @default(ACTIVE)
  startsAt             DateTime         @default(now())
  endsAt               DateTime?
  assignedById         String?
  replacedAssignmentId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  deviceSlot DeviceSlot @relation(fields: [deviceSlotId], references: [id], onDelete: Cascade)
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignedBy User?      @relation(fields: [assignedById], references: [id])
}

// ─── Analytics & Leads ───────────────────────────────────────────────────────

model TapEvent {
  id           String   @id @default(cuid())
  businessId   String?
  deviceSlotId String
  campaignId   String?
  visitorHash  String?
  userAgent    String?
  referrer     String?
  createdAt    DateTime @default(now())

  business   Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  deviceSlot DeviceSlot @relation(fields: [deviceSlotId], references: [id], onDelete: Cascade)
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([deviceSlotId, createdAt])
  @@index([businessId, createdAt])
}

model ClickEvent {
  id           String   @id @default(cuid())
  businessId   String?
  deviceSlotId String?
  campaignId   String?
  eventType    String
  blockId      String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  business   Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  deviceSlot DeviceSlot? @relation(fields: [deviceSlotId], references: [id], onDelete: SetNull)
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId, eventType])
}

model Lead {
  id            String   @id @default(cuid())
  businessId    String
  campaignId    String?
  deviceSlotId  String?
  /**
   * Bridge to canonical Contact when audience spine is available
   */
  contactId     String?
  name          String?
  email         String
  phone         String?
  metadata      Json     @default("{}")
  consentGiven  Boolean  @default(false)
  couponClaimed Boolean  @default(false)
  createdAt     DateTime @default(now())

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  deviceSlot DeviceSlot? @relation(fields: [deviceSlotId], references: [id], onDelete: SetNull)
  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([contactId])
}

// ─── Scan Sessions ───────────────────────────────────────────────────────────

model ScanSession {
  id                  String            @id @default(cuid())
  businessId          String
  createdByUserId     String
  status              ScanSessionStatus @default(WAITING)
  sessionType         ScanSessionType   @default(OWNER_PHONE)
  expiresAt           DateTime
  scannedDeviceSlotId String?
  scannedByUserId     String?
  scannedAt           DateTime?
  accessCode          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

// ─── Media & Templates (placeholders — wired when integrations added) ─────────

model MediaAsset {
  id              String              @id @default(cuid())
  businessId      String
  campaignId      String?
  url             String
  storageKey      String?
  contentHash     String?
  filename        String?
  mimeType        String
  sizeBytes       Int                 @default(0)
  width           Int?
  height          Int?
  source          String              @default("upload") // upload | pexels | logo_dev | url
  provider        String?
  providerAssetId String?
  providerId      String? // legacy compatibility
  sourcePageUrl   String?
  sourceUrl       String? // legacy compatibility
  creatorName     String?
  creatorUrl      String?
  attributionName String? // legacy compatibility
  attributionUrl  String? // legacy compatibility
  licenseCode     MediaLicenseCode?
  licenseUrl      String?
  attributionText String?
  rightsNote      String?
  rights          String? // legacy compatibility
  approvalStatus  MediaApprovalStatus @default(UNREVIEWED)
  approvedAt      DateTime?
  approvedById    String?
  defaultAltText  String?
  parentAssetId   String?
  renditionKind   String?
  importedAt      DateTime?
  createdAt       DateTime            @default(now())

  business               Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign               Campaign?               @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  approvedBy             User?                   @relation("MediaAssetApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  parentAsset            MediaAsset?             @relation("MediaAssetDerivatives", fields: [parentAssetId], references: [id], onDelete: SetNull)
  derivatives            MediaAsset[]            @relation("MediaAssetDerivatives")
  favorites              MediaAssetFavorite[]
  recents                MediaAssetRecent[]
  usages                 CreativeAssetUsage[]
  collectionMembers      MediaCollectionMember[]
  knowledgeSources       KnowledgeSource[]
  brandPropertyDecisions BrandPropertyDecision[]
  platformUserPhotos     User[]                  @relation("PlatformUserProfilePhoto")

  @@unique([businessId, provider, providerAssetId])
  @@index([businessId, approvalStatus, createdAt])
  @@index([businessId, contentHash])
}

/// Owner-facing Collection — organization only; does not duplicate MediaAsset bytes.
model MediaCollection {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  icon        String?
  accent      String?
  sortOrder   Int      @default(0)
  pinned      Boolean  @default(false)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent   MediaCollection?        @relation("MediaCollectionNesting", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaCollection[]       @relation("MediaCollectionNesting")
  members  MediaCollectionMember[]

  @@unique([businessId, name])
  @@index([businessId, sortOrder])
  @@index([businessId, pinned, updatedAt])
}

model MediaCollectionMember {
  id           String   @id @default(cuid())
  businessId   String
  collectionId String
  mediaAssetId String
  sortOrder    Int      @default(0)
  addedAt      DateTime @default(now())

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  collection MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([collectionId, mediaAssetId])
  @@index([businessId, mediaAssetId])
  @@index([collectionId, sortOrder])
}

model MediaAssetFavorite {
  id           String   @id @default(cuid())
  businessId   String
  userId       String
  mediaAssetId String
  createdAt    DateTime @default(now())

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, mediaAssetId])
  @@index([businessId, userId, createdAt])
}

model MediaAssetRecent {
  id           String   @id @default(cuid())
  businessId   String
  userId       String
  mediaAssetId String
  lastUsedAt   DateTime @default(now())
  useCount     Int      @default(1)

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, mediaAssetId])
  @@index([businessId, userId, lastUsedAt])
}

model CreativeAssetUsage {
  id           String              @id @default(cuid())
  businessId   String
  mediaAssetId String
  surface      CreativeSurfaceKind
  subjectId    String
  documentPath String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([businessId, surface, subjectId, documentPath, mediaAssetId])
  @@index([businessId, mediaAssetId])
}

model CreativeResource {
  id                String                 @id @default(cuid())
  businessId        String
  kind              CreativeResourceKind
  name              String
  activeNameKey     String?                @unique
  status            CreativeResourceStatus @default(DRAFT)
  currentRevisionId String?                @unique
  createdById       String
  updatedById       String
  approvedById      String?
  approvedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  business        Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy       User                       @relation("CreativeResourceCreatedBy", fields: [createdById], references: [id])
  updatedBy       User                       @relation("CreativeResourceUpdatedBy", fields: [updatedById], references: [id])
  approvedBy      User?                      @relation("CreativeResourceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  revisions       CreativeResourceRevision[] @relation("ResourceRevisions")
  currentRevision CreativeResourceRevision?  @relation("CurrentResourceRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  usages          CreativeResourceUsage[]
  favorites       CreativeResourceFavorite[]
  recents         CreativeResourceRecent[]

  @@index([businessId, kind, status])
  @@index([businessId, updatedAt])
}

model CreativeResourceRevision {
