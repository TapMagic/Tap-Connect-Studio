  createdAt    DateTime               @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([businessId, createdAt])
}

model TapCase {
  id             String          @id @default(cuid())
  businessId     String
