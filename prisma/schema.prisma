enum FusionAuditActorType {
  USER
  SYSTEM
  PUBLIC
  ADMIN
}

enum FusionOutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum FusionTapPointStatus {
  UNASSIGNED
  ACTIVE
  PAUSED
  LOST
  REPLACED
  RETIRED
}

/**
 * Scoped feature overrides — Feature Registry IDs live in code; overrides persist here.
 */
model FeatureFlagOverride {
