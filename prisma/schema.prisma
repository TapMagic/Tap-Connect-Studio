  userId     String
  resourceId String
  lastUsedAt DateTime @default(now())
  useCount   Int      @default(1)

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource CreativeResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, resourceId])
  @@index([businessId, userId, lastUsedAt])
}

model SavedTemplate {
  id             String       @id @default(cuid())
  businessId     String
  name           String
  campaignType   CampaignType
  contentBlocks  Json         @default("[]")
  themeOverrides Json         @default("{}")
  thumbnailUrl   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

enum JourneyLifecycleStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  PAUSED
}

/**
 * TapFlow journey drafts — JSON definition + lifecycle for publish/activate/pause
 */
model JourneyDraft {
  id            String                 @id @default(cuid())
  businessId    String
  name          String
  definition    Json                   @default("{}")
  schemaVersion Int                    @default(1)
  status        JourneyLifecycleStatus @default(DRAFT)
  publishedAt   DateTime?
  activatedAt   DateTime?
  pausedAt      DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  business          Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  publishedVersions JourneyPublishedVersion[]
  executions        JourneyExecution[]

  @@index([businessId, updatedAt])
  @@index([businessId, status])
}

enum JourneyExecutionStatus {
  RUNNING
  WAITING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
  BLOCKED
  HANDOFF
}

enum JourneyExecutionStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  RETRYING
  WAITING
  BLOCKED
}

/**
 * Immutable definition snapshot — ACTIVE visitor runs bind here, not mutable drafts.
 */
model JourneyPublishedVersion {
  id          String    @id @default(cuid())
  businessId  String
  journeyId   String
  version     Int
  name        String
  definition  Json
  publishedAt DateTime  @default(now())
  activatedAt DateTime?
  createdAt   DateTime  @default(now())

  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  journey    JourneyDraft       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  executions JourneyExecution[]

  @@unique([journeyId, version])
  @@index([businessId, journeyId])
}

/**
 * Persisted live visitor execution instance (one engine with dry-run / simulate).
 */
model JourneyExecution {
  id                 String                 @id @default(cuid())
  businessId         String
  journeyId          String
  publishedVersionId String
  idempotencyKey     String
  status             JourneyExecutionStatus @default(RUNNING)
  currentNodeId      String?
  visitorHash        String
  sessionId          String?
  contactId          String?
  relationshipId     String?
  campaignId         String?
  deviceSlotId       String?
  tapPointId         String?
  definitionSnapshot Json
  path               Json                   @default("[]")
  visitorContext     Json                   @default("{}")
  waitUntil          DateTime?
  retryCount         Int                    @default(0)
  maxRetries         Int                    @default(3)
  lastError          String?
  startedAt          DateTime               @default(now())
  completedAt        DateTime?
  pausedAt           DateTime?
  cancelledAt        DateTime?
  metadata           Json                   @default("{}")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  business         Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  journey          JourneyDraft            @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  publishedVersion JourneyPublishedVersion @relation(fields: [publishedVersionId], references: [id], onDelete: Restrict)
  steps            JourneyExecutionStep[]
  providerEvents   JourneyProviderEvent[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, updatedAt])
  @@index([businessId, visitorHash])
  @@index([journeyId, status])
  @@index([publishedVersionId])
  @@index([sessionId])
}

model JourneyExecutionStep {
  id          String                     @id @default(cuid())
  executionId String
  businessId  String
  nodeId      String
  nodeType    String
  action      String
  status      JourneyExecutionStepStatus @default(SUCCEEDED)
  detail      String?
  attempt     Int                        @default(1)
  effectRef   String?
  occurredAt  DateTime                   @default(now())
  metadata    Json                       @default("{}")

  execution JourneyExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, occurredAt])
  @@index([businessId, occurredAt])
}

/**
 * Provider / webhook intake — unique event keys prevent duplicate side effects.
 */
model JourneyProviderEvent {
  id          String   @id @default(cuid())
  businessId  String
  provider    String
  eventKey    String
  executionId String?
  payload     Json     @default("{}")
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  execution JourneyExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@unique([businessId, provider, eventKey])
  @@index([businessId, processedAt])
}

model ScheduleRule {
  id           String    @id @default(cuid())
  businessId   String
  deviceSlotId String
  campaignId   String
  label        String
  daysOfWeek   Json      @default("[]") // [1,2,3,4,5] Mon=1
  startTime    String? // "17:00"
  endTime      String? // "23:59"
  startDate    DateTime?
  endDate      DateTime?
  priority     Int       @default(0)
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deviceSlot DeviceSlot @relation(fields: [deviceSlotId], references: [id], onDelete: Cascade)
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([deviceSlotId, enabled])
}

// ─── Platform marketing CMS ───────────────────────────────────────────────────

/**
 * Editable "Built for the physical world" tiles on the public landing page.
 */
model LandingUseCase {
  id                String   @id @default(cuid())
  industry          String
  imageUrl          String
  imageAlt          String   @default("")
  tap               String   @default("")
  opens             String   @default("")
  action            String   @default("")
  captures          String   @default("")
  imageFit          String   @default("cover") // cover | contain
