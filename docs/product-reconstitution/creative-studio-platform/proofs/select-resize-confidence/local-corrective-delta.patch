+/** Exact Inspector sizing consumes the same resize policy as pointer handles. */
+export function resizeLayeredNodeDimension(block: CreativeCompositionBlock, nodeId: string, axis: "width" | "height", value: number): CreativeCompositionBlock {
+  const node = block.nodes.find((candidate) => candidate.id === nodeId);
+  if (!node || node.locked || !Number.isFinite(value)) return block;
+  const policy = layeredResizePolicy(node);
+  if (policy === "width-only" && axis === "height") return block;
+  const minHeight = layeredMinimumFrameSize(node).height;
+  if (policy === "governed-aspect") {
+    const scale = clamp(value / node[axis], Math.max(.08 / node.width, minHeight / node.height), Math.min(1 / node.width, 1 / node.height));
+    return applyLayeredResize(block, nodeId, { ...node, width: node.width * scale, height: node.height * scale });
+  }
+  return applyLayeredResize(block, nodeId, { ...node, [axis]: clamp(value, axis === "width" ? .08 : minHeight, 1) });
+}
+
+/** Stop the resize at the parent boundary without translating its fixed edge.
+ * Interpolation preserves the opposite local edge for rotated gestures and the
+ * aspect ratio for governed frames. Bounds concern Placement, not paint overflow.
+ */
+export function applyLayeredResize(block: CreativeCompositionBlock, nodeId: string, frame: { x: number; y: number; width: number; height: number }): CreativeCompositionBlock {
+  const node = block.nodes.find((candidate) => candidate.id === nodeId);
+  if (!node || node.locked) return block;
+  if (layeredBoundsPolicy(block, node.parentId ?? null) === "allow-overflow") return moveLayeredNode(block, nodeId, frame);
+  let progress = 1;
+  for (const [start, end] of [[node.x, frame.x], [node.y, frame.y], [1 - node.x - node.width, 1 - frame.x - frame.width], [1 - node.y - node.height, 1 - frame.y - frame.height]]) {
+    if (start >= 0 && end < 0) progress = Math.min(progress, start / (start - end));
+  }
+  const at = (key: "x" | "y" | "width" | "height") => node[key] + (frame[key] - node[key]) * progress;
+  return moveLayeredNode(block, nodeId, { x: at("x"), y: at("y"), width: at("width"), height: at("height") });
