# ─── Maps / commerce / ops (optional) ─────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
BOOKING_PROVIDER_API_KEY=
POS_PROVIDER_API_KEY=
CRM_PROVIDER_API_KEY=
SIMPLECONSIGN_API_KEY=
SENTRY_DSN=

# Railway often provides these automatically for public URL fallback:
# RAILWAY_PUBLIC_DOMAIN=
# RAILWAY_STATIC_URL=

# ─── Creative Studio draft preview (QR Live Device) ─────────────────────────
# Reachable base URL for phone QR (never use localhost for real-device tests).
NEXT_PUBLIC_PREVIEW_BASE_URL=
PREVIEW_TOKEN_SECRET=
PREVIEW_TOKEN_TTL_MINUTES=60
# local_test allows preview session create without Clerk in development.
PREVIEW_RUNTIME_MODE=local_test
