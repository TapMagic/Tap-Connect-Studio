# TapConnect Studio — environment variables
# Copy to .env.local for local development. Set the same keys in Railway.
# Missing keys do not block architecture, Admin UX, mocks, or readiness checks.
# Never commit real secrets.

# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host:5432/tapconnect"
# Optional direct (non-pooled) connection for migrations
DIRECT_URL=
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth/continue
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/continue

# Comma-separated platform admin emails (unlimited workspace + /admin + /admin/platform)
PLATFORM_ADMIN_EMAILS=richsoehner@gmail.com,dannygenerate@gmail.com

# ─── Media / storage ──────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

UPLOADTHING_TOKEN=
UPLOADTHING_APP_ID=

PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
NEXT_PUBLIC_HAS_UNSPLASH=false
LOGO_DEV_TOKEN=
MEDIA_CANDIDATE_SIGNING_SECRET=
# Development/test only. Ignored in production.
CREATIVE_PROVIDER_MODE=
CREATIVE_PROVIDER_FIXTURE_SCENARIO=

# ─── AI / Autopilot ───────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# local_mock keeps Autopilot honest without a key: deterministic prepared
# examples, manual editing preserved, provider readiness shown truthfully.
AI_RUNTIME_MODE=local_mock

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="TapConnect Studio <hello@tapthemagic.com>"
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_SECRET_PREVIOUS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_RECEIVING_DOMAIN=
EMAIL_REPLY_ALIAS_DOMAIN=
EMAIL_REPLIES_STORE=prisma
# local_mock: authoring, previews, and Reply Routing work without Resend;
# nothing is sent externally and no delivery is claimed.
EMAIL_RUNTIME_MODE=local_mock
GETRESPONSE_API_KEY=

# ─── Stripe (billing connector — architected; wire when ready) ────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# test keeps checkout in simulation; live requires explicit opt-in.
STRIPE_MODE=test
STRIPE_LIVE_ENABLED=false

# ─── Public product family ────────────────────────────────────────────────────
NEXT_PUBLIC_TAP_THE_MAGIC_URL=
NEXT_PUBLIC_PET_FINDER_URL=
NEXT_PUBLIC_TAPSTAY_URL=

# ─── Observability ────────────────────────────────────────────────────────────
UPTIMEROBOT_MONITOR_URL=

# ─── Wallet ───────────────────────────────────────────────────────────────────
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=
APPLE_PASS_CERT=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# ─── Meta / messaging ─────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
MANYCHAT_API_KEY=
TELEGRAM_BOT_TOKEN=
SMS_PROVIDER_API_KEY=

# ─── Social (TapCast) ─────────────────────────────────────────────────────────
