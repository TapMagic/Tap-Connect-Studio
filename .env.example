# Mock adapters work without these. Live OAuth = VERIFIED — CREDENTIALS REQUIRED.
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
